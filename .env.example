# Postgres connection string (Supabase or Neon).
# For local dev without a provisioned DB, use an embedded PGlite instance instead:
#   DATABASE_URL=pglite://.pglite-data
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only needed when self-hosting behind a reverse proxy (not required on Vercel).
AUTH_TRUST_HOST=true

# Resend (magic link email + transactional email)
AUTH_RESEND_KEY=
EMAIL_FROM=Casa Chefs <orders@casachefs.com>
